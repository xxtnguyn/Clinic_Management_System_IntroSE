@startuml
' Direction
left to right direction

class Patients {
    +int id
    +string full_name
    +string gender
    +int birth_year
    +string phone
    +string address
    +time created_at
    +time updated_at
    +calculate_age(birth_year: int): int
    +update_updated_at(): void
}

class AppointmentLists {
    +int id
    +int patient_id
    +date appointment_date
    +time appointment_time
    +int order_number
    +string status
    +string notes
    +time created_at
    +time updated_at
    +check_max_patients_per_day(): bool
    +update_updated_at(): void
}

class MedicalRecords {
    +int id
    +int patient_id
    +date examination_date
    +int staff_id
    +string symptoms
    +string diagnosis
    +int disease_type_id
    +string status
    +string notes
    +time created_at
    +time updated_at
    +update_updated_at(): void
}

class Prescriptions {
    +int id
    +int medical_record_id
    +int medical_id
    +int staff_id
    +int quantity
    +int usage_instruction_id
    +string notes
    +time created_at
    +time updated_at
    +check_medicine_stock(): bool
    +update_medicine_stock(): void
    +update_updated_at(): void
}

class Medicines {
    +int id
    +string name
    +string unit
    +decimal price
    +int quantity_in_stock
    +string description
    +time created_at
    +time updated_at
    +check_max_medicines(): bool
    +update_medicine_stock(): void
    +update_updated_at(): void
}

class UsageInstructions {
    +int id
    +string instruction
    +string description
    +time created_at
    +time updated_at
    +check_max_usage_instructions(): bool
    +update_updated_at(): void
}

class Staff {
    +int id
    +string username
    +string password
    +string full_name
    +string email
    +string phone
    +string address
    +int role_id
    +bool is_active
    +time last_login
    +time created_at
    +time updated_at
    +update_updated_at(): void
}

class Roles {
    +int id
    +string name
    +string description
    +time created_at
    +time updated_at
    +update_updated_at(): void
}

class Permissions {
    +int id
    +string name
    +string description
    +time created_at
    +time updated_at
    +update_updated_at(): void
}

class RolePermissions {
    +int role_id
    +int permission_id
    +time created_at
    +time updated_at
    +update_updated_at(): void
}

class Invoices {
    +int id
    +int medical_record_id
    +decimal examination_fee
    +int staff_id
    +decimal medicine_fee
    +decimal total_fee
    +time payment_date
    +string status
    +string notes
    +time created_at
    +time updated_at
    +calculate_total_fee(): void
    +get_monthly_revenue(month: int, year: int): table
    +update_updated_at(): void
}

class DiseaseTypes {
    +int id
    +string name
    +string description
    +time created_at
    +time updated_at
    +check_max_disease_types(): bool
    +update_updated_at(): void
}

class Settings {
    +int id
    +string key
    +string value
    +time updated_at
    +time created_at
    +str description
    +update_updated_at(): void
}

' Relationships
Patients --> AppointmentLists : Manage
AppointmentLists --> MedicalRecords : Manage
MedicalRecords --> Prescriptions : Manage
Prescriptions --> Medicines : Use
Staff --> Invoices : Manage
Staff --> Roles : Belong
Roles --> RolePermissions : Manage
RolePermissions --> Permissions : Manage
Medicines --> Permissions : Use

@enduml